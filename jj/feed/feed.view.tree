$bog_jj_feed $mol_page
	title @ \Feed
	search \
	tag \
	My_blogs_title @ \My blogs
	Feed_title @ \Latest
	Empty_hint @ \Quiet for now. Create a blog or subscribe to someone else.
	Nothing_found @ \Nothing matches your search yet.
	Create_hint @ \Create blog
	head /
		<= Title
	body /
		<= My_blogs $mol_list
			rows /
				<= My_blogs_head $mol_paragraph
					title <= My_blogs_title
				<= My_blogs_list $mol_list
					rows <= my_blog_rows /
						<= My_blog* $mol_link
							arg *
								blog <= my_blog_link* \
								post null
								tag null
								settings null
							sub /
								<= My_blog_avatar* $mol_view
									style <= my_blog_avatar_style* *
								<= My_blog_title* $mol_view
									sub / <= my_blog_title* \
				<= Create_row $mol_row
					sub <= create_rows /
						<= Create $mol_button_major
							title <= Create_hint
							click? <=> create_toggle? null
						<= Create_form $mol_row
							sub /
								<= Create_input $mol_string
									hint @ \Blog name
									value? <=> create_title? \
									submit? <=> create? null
								<= Create_button $mol_button_major
									title <= Create_hint
									click? <=> create? null
		<= Tags $mol_view
			sub <= tag_links /
				<= Tag* $mol_link
					arg *
						tag <= tag_link* \
						post null
						blog null
					title <= tag_title* \
		<= Feed $mol_list
			rows <= feed_rows /
				<= Feed_head $mol_paragraph
					title <= Feed_title
				<= Cards $mol_list
					rows <= cards /
						<= Card* $bog_jj_card
							post_link <= card_post* \
							blog_link <= card_blog* \
							tag_select? <=> tag_select? null
				<= Empty $mol_paragraph
					title <= feed_empty \
