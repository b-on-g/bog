$bog_jj_card $mol_card
	post_link \
	blog_link \
	Open_hint @ \Read
	Tag_hint @ \All posts with this tag
	Untitled @ \Untitled
	tag_select? null
	sub <= card_rows /
		<= Cover $mol_link
			hint <= Open_hint
			arg *
				post <= post_link
				blog null
				tag null
			sub /
				<= Cover_image $mol_view
					style <= cover_style *
		<= Info $mol_list
			rows <= info_rows /
				<= Tags $mol_view
					sub <= tags /
				<= Title $mol_link
					arg *
						post <= post_link
						blog null
						tag null
					sub / <= title_text \
				<= Excerpt $mol_paragraph
					title <= excerpt \
				<= Meta $mol_view
					sub /
						<= Author $mol_link
							arg *
								blog <= blog_link
								post null
								tag null
							title <= author_name \
						<= Date_text $mol_paragraph
							title <= date_text \
						<= Likes $mol_view
							sub /
								<= Likes_icon $mol_icon_heart
								<= likes_text \
	Tag* $mol_button_minor
		title <= tag_title* \
		hint <= tag_hint* \
		click? <=> tag_click*? null
