$bog_jj_post $mol_page
	post_link \
	blog_link \
	Editable true
	title @ \Post
	Untitled @ \Untitled
	Published_on @ \Published
	Published_off @ \Draft
	Save_hint @ \Edit
	Publish_hint @ \Publish
	Unpublish_hint @ \To draft
	Delete_hint @ \Delete post
	Delete_confirm @ \Delete this post forever?
	Delete_yes @ \Delete
	Delete_no @ \Cancel
	Cover_add @ \Cover
	Cover_drop @ \Remove cover
	Author_link @ \All author posts
	Comments_title @ \Comments
	Comment_hint @ \Your comment
	Comment_send @ \Send
	Comment_reply @ \Reply
	Comment_drop @ \Delete
	Comment_cancel_hint @ \Cancel
	Like_hint @ \Like
	Comments_empty @ \Nobody has commented yet
	head /
		<= Back $mol_link
			arg *
				post null
				blog <= blog_link
				tag null
			hint @ \To blog
			sub / <= Back_icon $mol_icon_arrow_left
		<= Title
		<= Tools
	tools /
		<= Tools_content $mol_row
			sub <= tools_rows /
				<= Edit_toggle $mol_check_icon
					hint <= Save_hint
					checked? <=> editing? false
					Icon <= Edit_icon $mol_icon_pencil
				<= Publish $mol_button_minor
					hint <= Publish_hint
					click? <=> publish? null
					sub / <= Publish_icon $mol_icon_send
				<= Delete $mol_pop
					showed? <=> delete_asked? false
					Anchor <= Delete_anchor $mol_button_minor
						hint <= Delete_hint
						click? <=> delete_ask? null
						sub / <= Delete_icon $mol_icon_close
					bubble_content /
						<= Delete_question $mol_paragraph
							title <= Delete_confirm
						<= Delete_actions $mol_row
							sub /
								<= Delete_no_button $mol_button_minor
									title <= Delete_no
									click? <=> delete_cancel? null
								<= Delete_yes_button $mol_button_major
									title <= Delete_yes
									click? <=> delete? null
	body /
		<= Article $mol_list
			rows <= article_rows /
				<= Cover $mol_view
					style <= cover_box_style *
					sub / <= Cover_image $mol_view
						style <= cover_style *
				<= Post_head $mol_view
					sub /
						<= Author $mol_link
							arg *
								blog <= blog_link
								post null
								tag null
							hint <= Author_link
							sub /
								<= Author_avatar $mol_view
									style <= author_avatar_style *
								<= Author_name $mol_link
									arg *
										blog <= blog_link
										post null
										tag null
									title <= blog_title \
						<= State $mol_paragraph
							title <= state_text \
						<= Date_text $mol_paragraph
							title <= date_text \
				<= Title_field $mol_string
					hint <= Untitled
					value? <=> post_title? \
				<= Title_text $mol_view
					sub / <= post_title_text \
				<= Tags $mol_select_list
					value? <=> tags? /string
					dictionary <= tag_dictionary *
				<= Tags_text $mol_view
					sub <= tag_links /
				<= Body_editor $giper_baza_rich_edit
					pawn <= body_pawn null
					enabled <= is_editing false
					style <= body_editor_style *
				<= Actions $mol_row
					sub <= action_rows /
						<= Like_button $mol_button_minor
							hint <= Like_hint
							click? <=> like_toggle? null
							sub /
								<= Like_icon $mol_icon_heart
								<= Likes_text \
						<= Cover_pick $mol_button_open
							multiple false
							accept \image/*
							hint <= Cover_add
							sub /
								<= Cover_native $mol_button_open_native
									files? <=> cover_add? /File
									accept \image/*
									multiple false
								<= Cover_pick_icon $mol_icon_image
						<= Cover_remove $mol_button_minor
							hint <= Cover_drop
							click? <=> cover_drop? null
							sub / <= Cover_remove_icon $mol_icon_close
		<= Comments $mol_list
			rows <= comment_rows /
				<= Comments_head $mol_paragraph
					title <= Comments_title
				<= Comment_form $mol_view
					sub <= comment_form_rows /
						<= Comment_input $mol_textarea
							hint <= Comment_hint
							value? <=> comment_draft? \
						<= Comment_send_button $mol_button_major
							title <= Comment_send
							click? <=> comment_submit? null
						<= Comment_cancel $mol_button_minor
							title <= Comment_cancel_hint
							click? <=> comment_cancel? null
				<= Comments_empty_view $mol_paragraph
					title <= Comments_empty
				<= Comment* $mol_view
					sub /
						<= Comment_indent* $mol_view
							style <= comment_indent_style* *
						<= Comment_card* $mol_card
							sub /
								<= Comment_head* $mol_view
									sub /
										<= Comment_author* $mol_avatar
											id <= comment_author_link* \
										<= Comment_date* $mol_paragraph
											title <= comment_date* \
								<= Comment_text* $mol_paragraph
									title <= comment_text* \
								<= Comment_actions* $mol_row
									sub /
										<= Comment_reply_button* $mol_button_minor
											title <= Comment_reply
											click? <=> comment_reply*? null
										<= Comment_drop_button* $mol_button_minor
											title <= Comment_drop
											enabled <= comment_mine* false
											click? <=> comment_drop_action*? null
	Tag_link* $mol_link
		arg *
			tag <= tag_link_tag* \
			post null
			blog null
		title <= tag_link_title* \
