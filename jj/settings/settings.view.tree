$bog_jj_settings $mol_page
	blog_link \
	title @ \Blog settings
	Avatar_title @ \Avatar
	Cover_title @ \Cover
	Cover_drop @ \Remove
	About_hint @ \About
	Title_hint @ \Blog name
	Socials_hint @ \Links separated by commas
	Access_title @ \Access
	Profile_title @ \Profile
	Pick @ \Upload
	Account_title @ \Your account
	Public_title @ \Public land
	Public_hint @ \Comments and likes live here. Share the link with readers: anyone can write.
	head /
		<= Back $mol_link
			arg *
				blog <= blog_link
				settings null
				post null
				tag null
			hint @ \To blog
			sub / <= Back_icon $mol_icon_arrow_left
		<= Title
	body /
		<= Profile_section $mol_section
			title <= Profile_title
			content /
				<= Title_field $mol_string
					hint <= Title_hint
					value? <=> blog_title? \
				<= About_field $mol_textarea
					hint <= About_hint
					value? <=> blog_about? \
				<= Socials_field $mol_textarea
					hint <= Socials_hint
					value? <=> socials_text? \
				<= Images $mol_row
					sub /
						<= Image_field*Avatar
						<= Image_field*Cover
		<= Access_section $mol_section
			title <= Access_title
			content /
				<= Account_label $mol_paragraph
					title <= Account_title
				<= Account_id $mol_button_copy
					title <= account_lord \
				<= Public $mol_view
					sub /
						<= Public_label $mol_paragraph
							title <= Public_title
						<= Public_text $mol_paragraph
							title <= Public_hint
						<= Public_link $mol_button_copy
							title <= public_link \
				<= Rights $giper_baza_land_rights
					land <= blog_land null
	Image_field* $mol_view
		sub <= image_rows* /
			<= Image_preview* $mol_view
				style <= image_preview_style* *
			<= Image_title* $mol_paragraph
				title <= image_title* \
			<= Image_actions* $mol_row
				sub <= image_actions_rows* /
					<= Image_pick* $mol_button_open
						multiple false
						accept \image/*
						hint <= Pick
						sub /
							<= Native* $mol_button_open_native
								files? <=> image_add*? /File
								accept \image/*
								multiple false
							<= Image_pick_icon* $mol_icon_image
							<= image_pick_text* \
					<= Image_drop* $mol_button_minor
						hint <= Cover_drop
						click? <=> image_drop*? null
						sub /
							<= image_drop_icon* $mol_icon_close
							<= image_drop_text* \
