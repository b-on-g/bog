$bog_jj_app $mol_page
	title @ \Live Journal
	Feed_title @ \Feed
	Search_hint @ \Search posts
	Tag_title @ \Tag
	tag_current \
	plugins /
		<= Theme $bog_theme_auto
			themes /
				\$mol_theme_light
				\$mol_theme_dark
		<= Skin $bog_builderui_skin
			lights <= lights \system
			base \zinc
			font_head \eb-garamond
		<= Ico $bog_favicon
			Icon <= ico $mol_icon_rss
	head /
		<= Title
		<= Tools
	tools /
		<= Search $mol_search
			hint <= Search_hint
			query? <=> search? \
		<= Sync $giper_baza_status
		<= Lights $bog_theme_toggle
			theme_auto <= Theme
	body /
		<= Nav $mol_row
			sub <= nav_rows /
				<= Home_link $mol_link
					arg *
						blog null
						post null
						tag null
						settings null
						edit null
						search null
					title <= Feed_title
				<= Tag_label $mol_paragraph
					title <= tag_text \
				<= Account $mol_paragraph
					title <= account_text \
		<= Pages $mol_list
			rows <= pages /
				<= Blog* $bog_jj_blog
					blog_link <= blog_link* \
				<= Post* $bog_jj_post
					post_link <= post_link* \
					blog_link <= post_blog_link* \
				<= Feed $bog_jj_feed
					search <= search
					tag <= tag_current
				<= Settings* $bog_jj_settings
					blog_link <= settings_blog* \
